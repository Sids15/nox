{
  "name": "nox",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "bun run --cwd apps/mobile start",
    "typecheck": "bun run --filter '*' typecheck",
    "secret-scan": "bash scripts/secret-scan",
    "audit": "bun run secret-scan"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
