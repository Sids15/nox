{
  "name": "nox",
  "version": "1.1.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "bun run --cwd apps/mobile start",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck && bun run typecheck:tests",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "secret-scan": "bash scripts/secret-scan",
    "audit": "bun run secret-scan"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@tauri-apps/plugin-notification": "^2.3.3"
  }
}
