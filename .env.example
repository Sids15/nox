# Nox environment — COPY to apps/mobile/.env and fill with your own values.
# NEVER commit a real .env (see rules.md). These EXPO_PUBLIC_* vars are inlined into the
# client bundle, so ONLY put values that are safe to be public:
#   - Supabase URL + ANON key are public by design (protected by Row Level Security).
#   - The Supabase service_role key must NEVER appear here or anywhere in the client.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Sentry DSN is safe to expose in a client app. Leave blank to disable in dev.
EXPO_PUBLIC_SENTRY_DSN=

# Optional: the public address of the Nox web app (e.g. https://nox.example.com). The "Save to Nox"
# bookmarklet opens it; without it, the bookmarklet uses the address the web app is open at.
EXPO_PUBLIC_WEB_URL=

# Optional: the public VAPID key for browser push (server reminders on the web). Its private half is
# the push function's VAPID_PRIVATE_KEY secret. Generate a pair with: npx web-push generate-vapid-keys
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# Optional: the domain that receives "Email to Nox" (e.g. in.nox.app), routed by Cloudflare Email
# Routing to cloudflare/email-worker. Leave blank to hide the feature.
EXPO_PUBLIC_INBOUND_EMAIL_DOMAIN=
