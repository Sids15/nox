{
  "expo": {
    "name": "Nox",
    "slug": "nox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nox",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0C13",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nox.app"
    },
    "android": {
      "package": "com.nox.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C0C13",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@sentry/react-native",
      "@react-native-community/datetimepicker",
      ["expo-audio", { "microphonePermission": "Allow Nox to record voice notes." }],
      ["expo-notifications", { "color": "#7C5CFF" }],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0C0C13"
        }
      ],
      "expo-web-browser"
    ]
  }
}
