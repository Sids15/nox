{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@nox/types": [
        "../../packages/types/src"
      ],
      "@nox/utils": [
        "../../packages/utils/src"
      ],
      "@nox/ui": [
        "../../packages/ui/src"
      ],
      "@nox/db": [
        "../../packages/db/src"
      ],
      "@nox/api": [
        "../../packages/api/src"
      ],
      "@nox/features": [
        "../../packages/features/src"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
