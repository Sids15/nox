#!/usr/bin/env bash
# Nox pre-commit secret scan (see rules.md).
# Prefers gitleaks; falls back to a high-signal pattern scan when gitleaks is unavailable.
# Only files git would include (tracked + untracked, honoring .gitignore/.git/info/exclude)
# are scanned — so .env, node_modules, dist, etc. are excluded automatically.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 2

echo "== Nox secret scan =="

if command -v gitleaks >/dev/null 2>&1; then
  echo "Using gitleaks..."
  gitleaks detect --no-banner --redact --source .
  exit $?
fi

echo "gitleaks not found — running fallback pattern scan (install gitleaks for deeper coverage)."
fail=0

# 1) No real .env may be tracked by git (.env.example is the only allowed env file).
tracked_env="$(git ls-files | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$' || true)"
if [ -n "$tracked_env" ]; then
  echo "ERROR: real .env file(s) are tracked by git:"
  echo "$tracked_env"
  fail=1
fi

# 2) High-signal patterns: real secret VALUES + this user's identifiers / machine paths.
#    (We match key values/assignments, not the words in prose/comments.)
PATTERNS=(
  'eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{6,}' # JWT (Supabase anon/service keys)
  'sb_secret_[A-Za-z0-9]{10,}'                                    # Supabase secret (service) key
  'service_role[[:alnum:]_"'"'"'[:space:]-]*[:=]'                 # service_role assignment
  'BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY'
  'AKIA[0-9A-Z]{16}'
  'xox[baprs]-[0-9A-Za-z-]+'
  'ghp_[0-9A-Za-z]{36}'
  'sk_live_[0-9A-Za-z]+'
  'AIza[0-9A-Za-z_-]{35}'                                         # Google / Gemini API key
  'AQ\.Ab[0-9A-Za-z_-]{30,}'                                       # Google AI Studio key (new format)
  'xai-[0-9A-Za-z]{40,}'                                          # xAI (Grok) key
  'sk-(proj-|ant-)?[0-9A-Za-z_-]{32,}'                            # OpenAI / Anthropic key
  'GEMINI_API_KEY[[:space:]]*=[[:space:]]*[A-Za-z0-9]'            # a Gemini key assigned in a file
  'C:\\Users\\'
  'Kensyi15'
  'siddhantbandi15@gmail\.com'
)

# Files git would include, minus this script (which necessarily contains the patterns above).
# A read loop, not `mapfile`: macOS still ships bash 3.2, where `mapfile` doesn't exist. There the
# old line failed, FILES stayed unset, and the scan printed "passed" having read no files at all.
FILES=()
while IFS= read -r file; do
  # A path deleted from the working tree but still in the index can't be read; skip it.
  [ -f "$file" ] && FILES+=("$file")
done < <(git ls-files --cached --others --exclude-standard | grep -v '^scripts/secret-scan$')

# Scanning nothing is a failure, never a pass — an empty list means the listing itself broke.
if [ "${#FILES[@]}" -eq 0 ]; then
  echo "ERROR: no files to scan (git ls-files returned nothing) — refusing to report a pass."
  exit 2
fi
echo "Scanning ${#FILES[@]} files..."

if [ "${#FILES[@]}" -gt 0 ]; then
  for pat in "${PATTERNS[@]}"; do
    hits="$(grep -InE -e "$pat" "${FILES[@]}" 2>/dev/null || true)"
    if [ -n "$hits" ]; then
      echo "POTENTIAL SECRET / PII (pattern: $pat):"
      echo "$hits"
      fail=1
    fi
  done
fi

echo ""
if [ "$fail" -ne 0 ]; then
  echo "Secret scan FAILED. Resolve the findings above before committing."
  exit 1
fi
echo "Secret scan passed. No obvious secrets or PII found."
